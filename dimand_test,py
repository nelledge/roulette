import pygame
import sys

pygame.init()

WIDTH, HEIGHT = 500, 500
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Diamond Button Test")

GREEN = (0, 150, 0)
RED = (200, 0, 0)
DARKRED = (150, 0, 0)

def main():
    running = True

    # Diamond center + size
    cx, cy = WIDTH // 2, HEIGHT // 2
    size = 100   # half of the diamond width/height

    # Diamond points
    diamond_points = [
        (cx, cy - size),  # top
        (cx + size, cy),  # right
        (cx, cy + size),  # bottom
        (cx - size, cy)   # left
    ]

    while running:
        screen.fill(GREEN)
        mouse_pos = pygame.mouse.get_pos()

        # Check if mouse is inside diamond (pygame has this built in!)
        is_hover = pygame.draw.polygon(screen, RED, diamond_points).collidepoint(mouse_pos)

        # Draw hover color
        if is_hover:
            pygame.draw.polygon(screen, DARKRED, diamond_points)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.MOUSEBUTTONDOWN:
                if is_hover:
                    print("Diamond button clicked!")

        pygame.display.flip()

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
